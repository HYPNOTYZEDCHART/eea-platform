# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT (À DUPLIQUER EN .env.local)
# NE COMMITEZ JAMAIS LE FICHIER .env.local SUR GITHUB AVEC DES VRAIES CLÉS !
# ==============================================================================

# 1. IDENTIFIANTS SUPABASE
# Récupérez vos nouvelles clés sur le tableau de bord Supabase (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# Rétrocompatibilité legacy (optionnel si les nouvelles clés ci-dessus sont définies)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secret optionnel pour le cron keep-alive /api/health
CRON_SECRET=your-random-cron-secret-min-32-chars

# 2. SÉCURITÉ ADMINISTRATION (Accès haute sécurité /admin avec 2FA OTP obligatoire)
ADMIN_EMAILS=direction@eea-afrique.org
ADMIN_PASSWORD=change_this_strong_admin_password_2026
ADMIN_OTP_SECRET_KEY=change_this_secret_otp_salt_for_production_min_32_chars

# Accès développeur isolé avec 2FA TOTP (Authenticator) + notification propriétaire (optionnel)
# ADMIN_DEV_EMAIL=dev@eea-afrique.org
# ADMIN_DEV_PASSWORD=your-separate-dev-password-min-20-chars
# ADMIN_DEV_TOTP_SECRET=BASE32_SECRET_32_CHARS
# RESEND_DEV_SILENT=true # En dev local uniquement : désactive les emails Resend réels

# 3. URL DE L'APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. CONTACT & ASSISTANCE WHATSAPP OFFICIELLE EEA
NEXT_PUBLIC_WHATSAPP_NUMBER=221XXXXXXXXX

# 5. SERVICE D'EMAILS TRANSACTIONNELS (RESEND)
# Obtenez votre clé API gratuite sur https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# En test gratuit : "EEA Secrétariat <onboarding@resend.dev>"
# En production (avec domaine vérifié eea-afrique.org) : "EEA Secrétariat <contact@eea-afrique.org>"
RESEND_FROM_EMAIL=EEA Secrétariat <onboarding@resend.dev>
