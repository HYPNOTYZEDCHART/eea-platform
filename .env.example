# ==============================================================================
# CONFIGURATION OFFICIELLE EEA - MODÈLE DE VARIABLES D'ENVIRONNEMENT
# Dupliquez ce fichier en .env.local et renseignez vos propres identifiants
# ==============================================================================

# 1. URL publique de l'application
NEXT_PUBLIC_APP_URL=https://eea-afrique.org

# 2. Supabase (Base de données PostgreSQL & Cloud Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Administration & Gouvernance Sécurisée (Accès /admin avec 2FA OTP)
ADMIN_EMAIL=direction@eea-afrique.org
ADMIN_EMAILS=direction@eea-afrique.org,secretariat@eea-afrique.org
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_OTP_SECRET_KEY=your-secret-hmac-salt-for-tokens
ADMIN_SECRET_PIN=your-admin-pin
ADMIN_MASTER_OTP=your-master-otp-code

# 4. Contact & Assistance WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=221XXXXXXXXX

# 5. Resend (Service d'expédition des notifications, codes 2FA & badges PDF)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=EEA Secrétariat <onboarding@resend.dev>
